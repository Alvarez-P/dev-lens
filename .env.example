NODE_ENV=
PORT=

# Database (PostgreSQL)
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

# Redis
REDIS_URL=

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Other
BULLMQ_REDIS_URL=
LOG_LEVEL=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
OAUTH_STATE_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=

# AI (optional — disabled by default)
# Master kill-switch for all AI features
AI_ENABLED=
# OpenAI provider (key value never read directly; OPENAI_API_KEY names the env var)
OPENAI_API_KEY=
OPENAI_MODEL=
# Ollama provider (default for local development)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Default provider name and default model identifier
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
# Per-request timeout in ms
AI_TIMEOUT_MS=
# Max LLM call attempts (incl. retry) and base backoff delay in ms
AI_RETRY_MAX_ATTEMPTS=
AI_RETRY_BACKOFF_MS=
# Hard token budget per prompt
AI_BUDGET_MAX_TOKENS=
