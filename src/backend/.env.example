# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://devlens:devlens@postgres:5432/devlens
DB_HOST=localhost
DB_PORT=5432
DB_USER=devlens
DB_PASS=devlens
DB_NAME=devlens

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=devlens

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Repository Storage
REPO_STORAGE_PATH=/tmp/devlens/repos
CREDENTIAL_ENCRYPTION_KEY=change-me-in-production

# Other
BULLMQ_REDIS_URL=redis://redis:6379
LOG_LEVEL=debug

# Static Analysis
# Share of changed files above which a full re-parse is preferred over an
# incremental (partial) re-parse. Range: 0 < threshold <= 1.
STATIC_ANALYSIS_THRESHOLD=0.5

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/github/callback
OAUTH_STATE_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=

# AI Enrichment (optional — disabled by default)
# Master kill-switch for all AI features
AI_ENABLED=false
# OpenAI provider (api_key_env points at the env var name; keys never hardcoded)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Ollama provider (default for local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Default provider/model selector in `provider/model` format
AI_DEFAULT_MODEL=ollama/llama3.2
# Per-request timeout in ms
AI_TIMEOUT_MS=60000
# Max LLM call attempts (incl. retry)
AI_RETRY_MAX_ATTEMPTS=2
# Hard token budget per prompt
AI_BUDGET_MAX_TOKENS=6000
