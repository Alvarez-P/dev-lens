# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://devlens:devlens@postgres:5432/devlens
DB_HOST=localhost
DB_PORT=5432
DB_USER=devlens
DB_PASS=devlens
DB_NAME=devlens

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=devlens

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Repository Storage
REPO_STORAGE_PATH=/tmp/devlens/repos
CREDENTIAL_ENCRYPTION_KEY=change-me-in-production

# Other
BULLMQ_REDIS_URL=redis://redis:6379
LOG_LEVEL=debug
